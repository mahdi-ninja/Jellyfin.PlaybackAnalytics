<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <AssemblyName>Jellyfin.Plugin.PlaybackAnalytics</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.PlaybackAnalytics</RootNamespace>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Library-wide playback and storage analytics for Jellyfin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/playbackAnalytics.html" />
    <EmbeddedResource Include="Configuration/playbackAnalytics.js" />
  </ItemGroup>

</Project>
